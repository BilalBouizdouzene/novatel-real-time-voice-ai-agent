# Copy this file to .env. Never commit API credentials.
ENVIRONMENT=development
LOG_LEVEL=INFO
OTEL_ENABLED=false
# Optional full OTLP/HTTP traces endpoint, e.g. http://localhost:4318/v1/traces.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Browser audio transport: mono signed PCM16 little-endian at 16 kHz.
MAX_AUDIO_CHUNK_BYTES=32000
VOICE_TRANSPORT=auto
WEBRTC_ENABLED=true
TTS_STREAM_SAMPLE_RATE=24000
TTS_AUDIO_FRAME_MS=40
KNOWLEDGE_BASE_DIR=knowledge_base/novatel
VECTOR_STORE_DIR=data/novatel_faiss
VAD_THRESHOLD=0.45
VAD_MIN_SPEECH_MS=200
VAD_MIN_SILENCE_MS=650
VAD_MAX_SPEECH_MS=20000
VAD_PRE_ROLL_MS=200

# faster-whisper downloads the selected model on first use.
WHISPER_MODEL=tiny
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=fr
WHISPER_CPU_THREADS=1
WHISPER_BEAM_SIZE=1
WHISPER_INITIAL_PROMPT=Service client NovaTel en français. Mots importants : abonnement, forfait, résilier, résiliation, facture, prélèvement, paiement, remboursement, réseau, itinérance. Exemple : comment résilier mon abonnement.

# Dense RAG uses this model when the configured cache disk-space threshold is met.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Below this free-space threshold, use local BM25 instead of downloading dense model weights.
RAG_DENSE_MIN_FREE_DISK_MB=1536
RAG_TOP_K=4
RAG_MIN_SCORE=0.30
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
# auto keeps dense FAISS with BM25 fallback; alternatives: bm25, dense, hybrid.
RAG_STRATEGY=auto
# Optional CrossEncoder model; downloads model weights on first use when non-empty.
RAG_RERANKER_MODEL=
DEMO_TICKETS_DB_PATH=data/novatel_demo_tickets.sqlite3
SUPPORT_CASES_DB_PATH=data/support_cases.sqlite3
# auto selects HubSpot when its token is set, otherwise the generic webhook when its URL is set.
# Set none to keep support cases in the local advisor inbox only.
CRM_PROVIDER=auto
# HubSpot private app token. Keep it server-side in .env; enable Tickets and Notes read/write scopes.
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_TICKET_PIPELINE=0
HUBSPOT_TICKET_STAGE=1
# Optional public HubSpot app for multi-company OAuth.
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
HUBSPOT_OAUTH_REDIRECT_URI=http://localhost:8000/auth/hubspot/callback
HUBSPOT_OAUTH_SCOPES=crm.objects.tickets.read crm.objects.tickets.write crm.objects.notes.read crm.objects.notes.write
HUBSPOT_OAUTH_DB_PATH=data/hubspot_oauth.sqlite3
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HUBSPOT_OAUTH_ENCRYPTION_KEY=
# Optional provider-neutral webhook for a custom CRM adapter (ignored when HubSpot is selected).
CRM_WEBHOOK_URL=
# Required with CRM_WEBHOOK_URL; use a random secret of at least 24 characters.
CRM_WEBHOOK_BEARER_TOKEN=
CRM_WEBHOOK_TIMEOUT_SECONDS=8
# Protects the live advisor inbox at /agent and /ws/agent. Generate a long random value.
AGENT_DASHBOARD_TOKEN=ton_secret_long_et_aleatoire

# Optional Twilio Trial phone demonstration.
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Prefer an API Key for production; keep Account SID above for the API URL.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
TWILIO_ADVISOR_NUMBER=
# Public HTTPS base URL, for example an ngrok or Cloudflare Tunnel URL.
TWILIO_WEBHOOK_BASE_URL=

# Gemini OpenAI-compatible endpoint. Put your Google AI Studio key in .env.
# For local Ollama, change the URL to http://localhost:11434/v1 and model to qwen2.5:3b.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=90
CONVERSATION_HISTORY_MESSAGES=8

# auto selects Piper, then eSpeak NG, then Windows System.Speech when available.
TTS_BACKEND=auto
PIPER_EXECUTABLE=piper
PIPER_VOICE_MODEL=
PIPER_VOICE_CONFIG=
ESPEAK_EXECUTABLE=espeak-ng
WINDOWS_POWERSHELL_EXECUTABLE=powershell.exe
TTS_LANGUAGE=fr
TTS_VOICE=
